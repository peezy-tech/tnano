{
  "name": "@t-nano/sdk",
  "version": "0.0.0",
  "description": "SDK-first harness switchboard runtime for T-Nano",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./conformance": {
      "types": "./src/conformance.ts",
      "import": "./src/conformance.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "engines": {
    "node": ">=24.13.1"
  }
}
